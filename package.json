{
  "name": "low-poly-racer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Low-poly stilistik masın yarış oyunu — Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server/index.mjs",
    "serve:dev": "AUTH_SECRET=dev-secret DB_FILE=./data/dev.db node server/index.mjs",
    "lint": "eslint src tests server netlify --max-warnings 0",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "test:perf": "playwright test tests/perf.spec.js",
    "test:shots": "playwright test tests/shots.spec.js",
    "test:leak": "playwright test tests/leak.spec.js",
    "test:mobile": "playwright test tests/ui-mobile.spec.js",
    "check": "npm run lint && npm run build && playwright test tests/smoke.spec.js tests/error-report.spec.js tests/box-invariant.spec.js",
    "test:items": "playwright test tests/box-invariant.spec.js",
    "test:feel": "playwright test tests/feel.spec.js",
    "test:overlap": "playwright test tests/overlap.spec.js",
    "test:zfight": "playwright test tests/zfight.spec.js",
    "test:hitch": "playwright test tests/hitch.spec.js",
    "test:errors": "playwright test tests/error-report.spec.js",
    "test:collide": "playwright test tests/collide.spec.js",
    "test:gameplay": "playwright test tests/gameplay.spec.js",
    "test:abilities": "playwright test tests/abilities.spec.js",
    "test:pace": "playwright test tests/pace.spec.js",
    "test:postfx": "playwright test tests/postfx.spec.js",
    "test:impact": "playwright test tests/impact.spec.js",
    "test:race-end": "playwright test tests/race-end.spec.js",
    "test:online": "playwright test tests/online.spec.js",
    "test:damage": "playwright test tests/damage.spec.js",
    "test:music": "playwright test tests/music.spec.js",
    "test:zen-ground": "playwright test tests/zen-ground.spec.js",
    "test:zen-contact": "playwright test tests/zen-contact.spec.js"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.10",
    "peerjs": "^1.5.5",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "vite": "^5.4.0"
  }
}
