{
  "name": "low-poly-racer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Low-poly stilistik masın yarış oyunu — Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node server/index.mjs",
    "serve:dev": "AUTH_SECRET=dev-secret DB_FILE=./data/dev.db node server/index.mjs",
    "lint": "eslint src tests server netlify",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "test:perf": "playwright test tests/perf.spec.js",
    "test:shots": "playwright test tests/shots.spec.js",
    "test:leak": "playwright test tests/leak.spec.js",
    "test:mobile": "playwright test tests/ui-mobile.spec.js",
    "check": "npm run lint && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.10",
    "peerjs": "^1.5.5",
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "vite": "^5.4.0"
  }
}
